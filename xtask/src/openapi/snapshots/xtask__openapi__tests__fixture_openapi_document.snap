          next_url_header: null
          max_pages: null
  /runs:
    get:
      operationId: runs
      description: Workflow runs.
      parameters:
      - name: per_page
        in: query
        required: false
        description: Number of results per page.
        schema:
          type: integer
          default: 30
          maximum: 100
        x-coral-pagination: true
      - name: page
        in: query
        required: false
        description: Page number.
        schema:
          type: integer
          default: 1
        x-coral-pagination: true
      responses:
        '200':
          description: Successful response.
          headers:
            Link:
              description: RFC 5988 pagination links; rel="next" points at the next page.
              schema:
                type: string
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/runs'
      x-coral:
        surface: table
        name: runs
