# Coral web authentication is optional. Local development defaults to disabled.
# CORAL_WEB_AUTH_MODE=disabled

# Hosted Coral web should set CORAL_WEB_AUTH_MODE=required and configure these server-only
# values. Never expose the session secret through a VITE_ variable.
# CORAL_WEB_SESSION_SECRET=
# CORAL_WEB_AUTH_ISSUER=https://coral.example.com
# CORAL_WEB_PUBLIC_URL=https://coral-web.example.com

# Choose one Coral web-to-Coral data-plane topology:
# 1. HTTPS (recommended for separate hosts or untrusted networks).
# CORAL_ENDPOINT=https://coral.internal.example.com
# 2. Explicit loopback HTTP (same host; bare localhost, 127/8, or bracketed [::1]).
# CORAL_ENDPOINT=http://127.0.0.1:14555
# 3. Trusted-network HTTP. This opt-in relaxes only Coral web-to-Coral transport.
# CORAL_ENDPOINT=http://coral.internal:14555
# CORAL_WEB_ALLOW_INSECURE_CORAL_ENDPOINT=true

# Optional session overrides. The cookie name must be an RFC 6265 token —
# letters, digits, or !#$%&'*+-.^_`|~. When CORAL_WEB_PUBLIC_URL is HTTPS, Coral web
# serves the session cookie as __Host-<name> and the CSRF cookie as
# __Host-<name>_csrf, which binds both to its exact host; a name that already
# starts with __Host- is kept as written. Over explicit-loopback HTTP the names
# carry no prefix, and a __Host- prefix is rejected because browsers discard it
# there. Coral web fails at startup rather than serving a session the browser
# will silently drop.
# CORAL_WEB_SESSION_COOKIE_NAME=coral_web_session
# CORAL_WEB_SESSION_MAX_AGE_SECONDS=3600

# Optional: the MCP clients that may have a Coral plugin. The onboarding prompt asks
# them to look for it. Unset or empty offers no plugin. See README.md.
# AGENTS_WITH_AVAILABLE_PLUGINS=claude, chatgpt
