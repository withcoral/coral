{
  "name": "reef",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run proto:gen && react-router build && node scripts/bundle-server.mjs",
    "dev": "npm run proto:gen && react-router dev",
    "start": "node server.mjs",
    "proto:gen": "buf generate --template buf.gen.yaml",
    "recipes:schema": "node scripts/recipe-schema.ts",
    "recipes:gmail": "node scripts/gmail-openapi.ts",
    "typecheck": "npm run proto:gen && npm run e2e:proto:gen && react-router typegen && tsc",
    "test": "npm run proto:gen && vitest run && npm run test:stories",
    "test:stories": "vitest run --config vitest.stories.config.ts",
    "test:server": "node --test server.test.mjs scripts/bundle-server.test.mjs",
    "test:e2e": "node e2e/scripts/container.ts",
    "test:e2e:native": "node e2e/scripts/run.ts",
    "e2e:proto:gen": "buf generate --template e2e/buf.gen.yaml",
    "e2e:self-check": "node e2e/scripts/self-check.ts",
    "e2e:serve": "node e2e/scripts/serve.ts",
    "e2e:refresh-viewer": "node e2e/scripts/refresh-viewer.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint --deny-warnings",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run proto:gen && storybook build",
    "storybook:doctor": "storybook doctor",
    "recipes:google": "node scripts/google-discovery-openapi.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@react-router/node": "8.4.0",
    "@tanstack/react-virtual": "^3.14.15",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/recipes": "^0.5.7",
    "classnames": "^2.5.1",
    "isbot": "^5",
    "jotai": "^3.0.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "react-toastify": "^11.1.0",
    "react-truncate-markup": "^5.1.2",
    "tinykeys": "^4.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@chromatic-com/storybook": "^5.4.0",
    "@emnapi/runtime": "^1.11.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@react-router/dev": "8.4.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-vitest": "^10.6.4",
    "@storybook/icons": "^2.1.0",
    "@storybook/react-vite": "^10.6.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/oidc-provider": "^9.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "chromatic": "^18.12.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "oidc-provider": "^9.12.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "react-hook-form": "^7.90.0",
    "storybook": "^10.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@storybook/addon-vitest": {
      "vitest": "^5.0.5",
      "@vitest/browser": "^5.0.5",
      "@vitest/browser-playwright": "^5.0.5"
    }
  }
}
