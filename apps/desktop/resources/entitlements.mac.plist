<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions required to run Electron. Without them the
  signed app crashes on launch under the hardened runtime that
  notarization requires.
-->
<plist version="1.0">
  <dict>
    <!-- V8 JIT-compiles JavaScript into executable memory at runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Electron/V8 also allocates executable pages without MAP_JIT
         (renderer processes, WebAssembly). -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The app loads libraries not signed with our Team ID: Electron's own
         frameworks and native Node modules. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
