<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  electron-builder applies this file to nested signed executables, including
  Electron helpers and the bundled Coral sidecar. Only the Electron helpers
  need MAP_JIT, so keep the shared inherited exception set minimal.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
