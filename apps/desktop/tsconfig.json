{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "electron"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "electron-builder.config.ts",
    "electron.vite.config.ts",
    "src/**/*.ts"
  ]
}
