{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    // electron-builder.config.ts is loaded, not compiled: Node's type stripping
    // needs the extension on its relative import of the shared app id.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "electron"],
    "lib": ["ES2024"]
  },
  "include": ["electron-builder.config.ts", "electron-builder.config.test.ts", "src/**/*.ts"]
}
