{
  "name": "coral-app",
  "productName": "Coral",
  "private": true,
  "version": "1.5.0",
  "description": "Coral desktop app",
  "author": "Coral",
  "license": "Apache-2.0",
  "homepage": "https://withcoral.com",
  "desktopName": "coral-app.desktop",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "node ./scripts/dev.mjs",
    "stage": "node ./scripts/stage.mjs",
    "package": "npm run build && electron-builder --config electron-builder.config.ts",
    "icons": "node ./scripts/render-icons.mjs",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check": "oxfmt --check && npm run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^24.19.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.72.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
