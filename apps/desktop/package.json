{
  "name": "@withcoral/desktop",
  "private": true,
  "version": "0.5.2",
  "description": "Coral desktop app",
  "author": "With Coral",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "clean:dist": "node ./scripts/clean-dist.mjs",
    "dev": "node ./scripts/dev.mjs",
    "prebuild": "npm run clean:dist && npm run stage:coral",
    "build": "electron-vite build --ignoreConfigWarning",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check",
    "prepackage": "npm run build",
    "package": "electron-builder --config electron-builder.config.ts",
    "prepackage:dir": "npm run build",
    "package:dir": "electron-builder --dir --config electron-builder.config.ts",
    "prepackage:dmg": "npm run build",
    "package:dmg": "electron-builder --mac dmg --config electron-builder.config.ts",
    "stage:coral": "node ./scripts/stage-coral.mjs"
  },
  "dependencies": {
    "add-mcp": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.2.7"
  }
}
