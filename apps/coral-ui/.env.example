# Coral UI authentication is optional. Local development defaults to disabled.
# CORAL_UI_AUTH_MODE=disabled

# Hosted Coral UI should set CORAL_UI_AUTH_MODE=required and configure these server-only
# values. Never expose the session secret through a VITE_ variable.
# CORAL_UI_SESSION_SECRET=
# CORAL_UI_AUTH_ISSUER=https://coral.example.com
# CORAL_UI_PUBLIC_URL=https://coral-ui.example.com

# Choose one Coral UI-to-Coral data-plane topology:
# 1. HTTPS (recommended for separate hosts or untrusted networks).
# CORAL_ENDPOINT=https://coral.internal.example.com
# 2. Explicit loopback HTTP (same host; bare localhost, 127/8, or bracketed [::1]).
# CORAL_ENDPOINT=http://127.0.0.1:14555
# 3. Trusted-network HTTP. This opt-in relaxes only Coral UI-to-Coral transport.
# CORAL_ENDPOINT=http://coral.internal:14555
# CORAL_UI_ALLOW_INSECURE_CORAL_ENDPOINT=true

# Optional session overrides. The cookie name must be an RFC 6265 token —
# letters, digits, or !#$%&'*+-.^_`|~ — and a __Host- or __Secure- prefix works
# only when CORAL_UI_PUBLIC_URL is HTTPS, since browsers discard those without
# Secure. Coral UI rejects both at startup rather than serving a session the browser
# will silently drop.
# CORAL_UI_SESSION_COOKIE_NAME=coral_ui_session
# CORAL_UI_SESSION_MAX_AGE_SECONDS=3600
