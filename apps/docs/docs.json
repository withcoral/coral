{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Coral Docs",
  "description": "Install Coral, publish providers from OpenAPI documents and MCP servers, and let your agents discover and call their operations over MCP.",
  "logo": "/images/coral-logo.svg",
  "favicon": "/images/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "colors": {
    "primary": "#171717",
    "light": "#fafafa",
    "dark": "#171717"
  },
  "background": {
    "color": {
      "light": "#ffffff"
    }
  },
  "fonts": {
    "heading": {
      "family": "ABC Marist",
      "weight": 400,
      "source": "https://withcoral.com/fonts/ABCMarist-Regular.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Inter"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": "github-light-default"
    }
  },
  "css": "/global.css",
  "navbar": {
    "links": [
      {
        "label": "Download",
        "href": "/getting-started/install-locally",
        "icon": "download"
      },
      {
        "type": "github",
        "href": "https://github.com/withcoral/coral"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "getting-started/quickstart",
          "getting-started/install-locally",
          {
            "group": "Shared server",
            "pages": [
              "getting-started/self-host",
              "getting-started/self-host/docker-compose",
              "getting-started/self-host/kubernetes"
            ]
          }
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/concepts",
          "guides/query-databases",
          {
            "group": "Providers",
            "pages": [
              "guides/providers/slack"
            ]
          }
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/configuration"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/getting-started/installation",
      "destination": "/getting-started/install-locally",
      "permanent": true
    },
    {
      "source": "/guides/self-host-with-docker",
      "destination": "/getting-started/self-host",
      "permanent": true
    },
    {
      "source": "/guides/deploy-on-kubernetes",
      "destination": "/getting-started/self-host",
      "permanent": true
    }
  ],
  "errors": {
    "404": {
      "title": "Looks like this page got lost at sea",
      "description": "The route you tried does not exist. Swim back to the [docs home](/) and pick a guide from there."
    }
  },
  "thumbnails": {
    "background": "/images/og-image.png",
    "appearance": "light"
  },
  "seo": {
    "metatags": {
      "canonical": "https://withcoral.com/docs"
    }
  },
  "search": {
    "prompt": "Search Coral docs..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "vscode",
      "mcp",
      "add-mcp"
    ],
    "display": "header"
  }
}
