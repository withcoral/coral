{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": ["node_modules/**", "apis/*/snapshot/**"]
}
