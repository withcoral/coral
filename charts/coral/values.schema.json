{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "config"
  ],
  "properties": {
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?$",
      "minLength": 1,
      "description": "The UI's host name, with no scheme or path."
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?$"
        },
        "mcp": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?$"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "annotations",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secretName"
          ],
          "properties": {
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "annotations",
        "parentRefs"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "description": "A Gateway API ParentReference.",
            "properties": {
              "group": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sectionName": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseUrl",
        "credentialsKey",
        "sessionSigningKey",
        "oidcClientSecret",
        "webSessionSecret",
        "license"
      ],
      "properties": {
        "databaseUrl": {
          "$ref": "#/definitions/secret"
        },
        "credentialsKey": {
          "$ref": "#/definitions/secret"
        },
        "sessionSigningKey": {
          "$ref": "#/definitions/secret"
        },
        "oidcClientSecret": {
          "$ref": "#/definitions/secret"
        },
        "webSessionSecret": {
          "$ref": "#/definitions/secret"
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "secretName",
            "key"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tls"
      ],
      "properties": {
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caBundle"
          ],
          "properties": {
            "caBundle": {
              "$ref": "#/definitions/caBundle"
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraCABundle"
      ],
      "properties": {
        "extraCABundle": {
          "$ref": "#/definitions/caBundle"
        }
      }
    },
    "usageReports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "type": "object",
      "description": "Coral's config.toml, merged on top of the chart's settings.",
      "required": [
        "auth"
      ],
      "properties": {
        "auth": {
          "type": "object",
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "type": "object",
              "required": [
                "issuer",
                "client_id"
              ],
              "properties": {
                "issuer": {
                  "type": "string",
                  "minLength": 1
                },
                "client_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "coral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "replicas",
        "resources",
        "probes",
        "podAnnotations",
        "serviceAccount",
        "extraEnv",
        "extraEnvFrom",
        "extraVolumes",
        "extraVolumeMounts"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startup",
            "readiness",
            "liveness"
          ],
          "properties": {
            "startup": {
              "$ref": "#/definitions/probe"
            },
            "readiness": {
              "$ref": "#/definitions/probe"
            },
            "liveness": {
              "$ref": "#/definitions/probe"
            }
          }
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "annotations"
          ],
          "properties": {
            "annotations": {
              "$ref": "#/definitions/annotations"
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/envVar"
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/volume"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/volumeMount"
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "replicas",
        "resources",
        "probes",
        "podAnnotations",
        "serviceAccount",
        "extraEnv",
        "extraEnvFrom",
        "extraVolumes",
        "extraVolumeMounts"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readiness",
            "liveness"
          ],
          "properties": {
            "readiness": {
              "$ref": "#/definitions/probe"
            },
            "liveness": {
              "$ref": "#/definitions/probe"
            }
          }
        },
        "agentsWithAvailablePlugins": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "description": "A client name, as coral-web accepts it.",
            "pattern": "^[A-Za-z0-9]+([ ._-][A-Za-z0-9]+)*$",
            "maxLength": 32
          }
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "annotations"
          ],
          "properties": {
            "annotations": {
              "$ref": "#/definitions/annotations"
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/envVar"
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/volume"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/volumeMount"
          }
        }
      }
    },
    "runExecutors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "maxRunsHeld",
        "terminationGracePeriodSeconds",
        "token",
        "previousToken",
        "resources",
        "probes",
        "podAnnotations",
        "extraEnv"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "maxRunsHeld": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "token": {
          "$ref": "#/definitions/secret"
        },
        "previousToken": {
          "$ref": "#/definitions/secret"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readiness",
            "liveness"
          ],
          "properties": {
            "readiness": {
              "$ref": "#/definitions/probe"
            },
            "liveness": {
              "$ref": "#/definitions/probe"
            }
          }
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "extraEnv": {
          "type": "array",
          "description": "Plain values only: a Run Executor reads no secret but its token.",
          "items": {
            "$ref": "#/definitions/plainEnvVar"
          }
        }
      }
    }
  },
  "definitions": {
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName",
        "key"
      ],
      "properties": {
        "secretName": {
          "type": "string"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "caBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configMapName",
        "secretName",
        "key"
      ],
      "properties": {
        "configMapName": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "envVar": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plainEnvVar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      }
    },
    "volume": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "volumeMount": {
      "type": "object",
      "required": [
        "name",
        "mountPath"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
