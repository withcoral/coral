      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "static-list-comprehension-projection",
      "feature": "ListExpressions",
      "query": "MATCH (p:Person) WHERE p.name = 'Alice' RETURN [x IN [1, 2, 3] WHERE x > 1 | x + 1] AS incremented, [city IN split('London,Paris', ',') | toUpper(city)] AS city_codes",
