        "kind": "error",
        "contains": "literal-only null comparisons"
      }
    },
    {
      "id": "range-and-split-list-projection",
      "feature": "ListExpressions",
      "query": "MATCH (p:Person) WHERE p.name = 'Alice' RETURN range(1, 3) AS numbers, split('red,blue', ',') AS colors, size(range(1, 3)) AS number_count",
      "expected": {
        "kind": "rows",
