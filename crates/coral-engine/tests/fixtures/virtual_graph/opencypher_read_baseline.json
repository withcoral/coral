        "ordered": true,
        "rows": [
          { "name": "Bob", "normalized_city": "missing" }
        ]
      }
    },
    {
      "id": "unsafe-literal-null-comparison-rejected",
      "feature": "NullSemantics",
      "query": "MATCH (p:Person) WHERE null = null RETURN p.name AS name",
