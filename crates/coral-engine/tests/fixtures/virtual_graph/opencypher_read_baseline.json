{
  "suite": "coral-opencypher-read-baseline",
  "description": "Curated openCypher TCK-style read-only scenarios that Coral claims for virtual graph execution. These scenarios are synthetic and run end-to-end through Cypher parsing, graph validation, SQL lowering, DataFusion execution, and result comparison.",
  "minimum_feature_counts": {
    "Aggregation": 5,
    "CountSubquery": 2,
    "ExistsSubquery": 1,
    "GraphMetadata": 5,
    "LiteralExpressions": 2,
    "ListExpressions": 4,
    "Match": 3,
    "MathematicalFunctions": 4,
    "NullSemantics": 3,
    "OptionalMatch": 4,
    "PathMetadata": 1,
    "PathValues": 3,
    "RelationshipProperties": 1,
    "ReturnDistinct": 1,
    "RowModifiers": 2,
    "ScalarExpressions": 21,
    "TypeConversion": 3,
    "Union": 2,
    "Unwind": 1,
    "VariableLengthPaths": 4,
    "Where": 10,
    "With": 4
  },
  "scenarios": [
    {
      "id": "match-labeled-node-return-property",
      "feature": "Match",
      "query": "MATCH (p:Person) RETURN p.name AS name ORDER BY name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Bob" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "match-directed-relationship",
      "feature": "Match",
      "query": "MATCH (a:Person)-[:KNOWS]->(b:Person) RETURN a.name AS source, b.name AS target ORDER BY source, target",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "source": "Alice", "target": "Bob" },
          { "source": "Alice", "target": "Carol" },
          { "source": "Bob", "target": "Carol" }
        ]
      }
    },
    {
      "id": "where-boolean-conjunction",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE p.age >= 30 AND p.active = true RETURN p.name AS name ORDER BY name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "where-in-list",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE p.city IN ['London', 'Paris'] RETURN p.name AS name ORDER BY name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "where-disjunction",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE p.age < 30 OR p.city = 'Paris' RETURN p.name AS name ORDER BY name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Bob" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "where-negation",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE NOT p.active RETURN p.name AS name ORDER BY name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Bob" }
        ]
      }
    },
    {
      "id": "where-string-predicates",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE p.name STARTS WITH 'A' OR p.name CONTAINS 'ar' RETURN p.name AS name ORDER BY name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "where-regex-predicate",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE p.name =~ 'A.*' RETURN p.name AS name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "where-xor-predicate",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE p.active XOR p.city = 'Paris' RETURN p.name AS name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "where-label-membership-predicate",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE 'Person' IN labels(p) AND NOT ('Service' IN labels(p)) RETURN count(p) AS people",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "people": 3 }
        ]
      }
    },
    {
      "id": "where-keys-membership-predicate",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE 'city' IN keys(p) AND NOT ('missing' IN keys(p)) RETURN count(p) AS people",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "people": 3 }
        ]
      }
    },
    {
      "id": "where-exists-property-predicate",
      "feature": "Where",
      "query": "MATCH (p:Person) WHERE exists(p.city) RETURN p.name AS name ORDER BY name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Bob" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "relationship-property-filter",
      "feature": "RelationshipProperties",
      "query": "MATCH (a:Person)-[r:KNOWS]->(b:Person) WHERE r.since >= 2021 RETURN a.name AS source, b.name AS target, r.since AS since ORDER BY source, target",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "source": "Alice", "target": "Carol", "since": 2022 },
          { "source": "Bob", "target": "Carol", "since": 2021 }
        ]
      }
    },
    {
      "id": "reverse-relationship-direction",
      "feature": "Match",
      "query": "MATCH (target:Person)<-[:KNOWS]-(source:Person) RETURN source.name AS source, target.name AS target ORDER BY source, target",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "source": "Alice", "target": "Bob" },
          { "source": "Alice", "target": "Carol" },
          { "source": "Bob", "target": "Carol" }
        ]
      }
    },
    {
      "id": "optional-match-preserves-unmatched-row",
      "feature": "OptionalMatch",
      "query": "MATCH (p:Person) OPTIONAL MATCH (p)-[:KNOWS]->(friend:Person) RETURN p.name AS person, friend.name AS friend ORDER BY person, friend",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice", "friend": "Bob" },
          { "person": "Alice", "friend": "Carol" },
          { "person": "Bob", "friend": "Carol" },
          { "person": "Carol" }
        ]
      }
    },
    {
      "id": "optional-match-null-filter",
      "feature": "OptionalMatch",
      "query": "MATCH (p:Person) OPTIONAL MATCH (p)-[:KNOWS]->(friend:Person) WITH p, friend WHERE friend IS NULL RETURN p.name AS name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "optional-match-coalesce",
      "feature": "OptionalMatch",
      "query": "MATCH (p:Person) OPTIONAL MATCH (p)-[:KNOWS]->(friend:Person) RETURN p.name AS person, coalesce(friend.name, 'none') AS friend ORDER BY person, friend",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice", "friend": "Bob" },
          { "person": "Alice", "friend": "Carol" },
          { "person": "Bob", "friend": "Carol" },
          { "person": "Carol", "friend": "none" }
        ]
      }
    },
    {
      "id": "aggregate-count-by-group",
      "feature": "Aggregation",
      "query": "MATCH (p:Person)-[:KNOWS]->(friend:Person) RETURN p.name AS person, count(friend) AS friend_count ORDER BY person",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice", "friend_count": 2 },
          { "person": "Bob", "friend_count": 1 }
        ]
      }
    },
    {
      "id": "aggregate-numeric-functions",
      "feature": "Aggregation",
      "query": "MATCH (p:Person) RETURN count(p) AS people, sum(p.age) AS age_sum, min(p.age) AS youngest, max(p.age) AS oldest",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "people": 3, "age_sum": 104, "youngest": 29, "oldest": 41 }
        ]
      }
    },
    {
      "id": "aggregate-count-distinct",
      "feature": "Aggregation",
      "query": "MATCH (p:Person) RETURN count(DISTINCT p.city) AS city_count",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "city_count": 3 }
        ]
      }
    },
    {
      "id": "aggregate-count-star",
      "feature": "Aggregation",
      "query": "MATCH (p:Person) RETURN count(*) AS people",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "people": 3 }
        ]
      }
    },
    {
      "id": "aggregate-statistical-functions",
      "feature": "Aggregation",
      "query": "MATCH (p:Person) RETURN avg(p.age) AS average_age, median(p.age) AS median_age, stDev(p.age) AS sample_age_stdev, stDevP(p.age) AS population_age_stdev",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          {
            "average_age": 34.666666666666664,
            "median_age": 34,
            "sample_age_stdev": 6.027713773341709,
            "population_age_stdev": 4.921607686744467
          }
        ]
      }
    },
    {
      "id": "aggregate-with-filter",
      "feature": "With",
      "query": "MATCH (p:Person)-[:KNOWS]->(friend:Person) WITH p.name AS person, count(friend) AS friend_count WHERE friend_count > 1 RETURN person, friend_count",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice", "friend_count": 2 }
        ]
      }
    },
    {
      "id": "count-subquery-projection",
      "feature": "CountSubquery",
      "query": "MATCH (p:Person) RETURN p.name AS person, COUNT { MATCH (p)-[:KNOWS]->(:Person) } AS friend_count ORDER BY friend_count DESC, person",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice", "friend_count": 2 },
          { "person": "Bob", "friend_count": 1 },
          { "person": "Carol", "friend_count": 0 }
        ]
      }
    },
    {
      "id": "count-subquery-predicate",
      "feature": "CountSubquery",
      "query": "MATCH (p:Person) WHERE COUNT { MATCH (p)-[:KNOWS]->(:Person) } > 1 RETURN p.name AS person",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice" }
        ]
      }
    },
    {
      "id": "exists-subquery-predicate",
      "feature": "ExistsSubquery",
      "query": "MATCH (p:Person) WHERE EXISTS { MATCH (p)-[:KNOWS]->(:Person) } RETURN p.name AS person ORDER BY person",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice" },
          { "person": "Bob" }
        ]
      }
    },
    {
      "id": "optional-match-multihop-chain",
      "feature": "OptionalMatch",
      "query": "MATCH (p:Person) OPTIONAL MATCH (p)-[:KNOWS]->(:Person)-[:KNOWS]->(foaf:Person) RETURN p.name AS person, coalesce(foaf.name, 'none') AS friend_of_friend ORDER BY person, friend_of_friend",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice", "friend_of_friend": "Carol" },
          { "person": "Bob", "friend_of_friend": "none" },
          { "person": "Carol", "friend_of_friend": "none" }
        ]
      }
    },
    {
      "id": "searched-case-expression",
      "feature": "ScalarExpressions",
      "query": "MATCH (p:Person) RETURN p.name AS name, CASE WHEN p.active THEN 'active' ELSE 'inactive' END AS status ORDER BY name",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice", "status": "active" },
          { "name": "Bob", "status": "inactive" },
          { "name": "Carol", "status": "active" }
        ]
      }
    },
    {
      "id": "literal-scalar-return-projection",
      "feature": "LiteralExpressions",
      "query": "MATCH (p:Person) RETURN p.name AS name, 'person' AS kind, 42 AS answer, 1.5 AS score, true AS literal_flag, null AS missing ORDER BY name LIMIT 1",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice", "kind": "person", "answer": 42, "score": 1.5, "literal_flag": true }
        ]
      }
    },
    {
      "id": "literal-list-return-projection",
      "feature": "LiteralExpressions",
      "query": "MATCH (p:Person) WHERE p.name = 'Alice' RETURN [1, 2, 3] AS ints, ['a', 'b'] AS strings, [true, false] AS flags",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "ints": [1, 2, 3], "strings": ["a", "b"], "flags": [true, false] }
        ]
      }
    },
    {
      "id": "literal-only-null-predicate-folding",
      "feature": "NullSemantics",
      "query": "MATCH (p:Person) WHERE coalesce(null, 'prod') = 'prod' AND null IS NULL AND nullIf('prod', 'prod') IS NULL RETURN count(p) AS people",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "people": 3 }
        ]
      }
    },
    {
      "id": "coalesce-nullif-normalizes-empty-string",
      "feature": "NullSemantics",
      "query": "MATCH (p:Person) WHERE coalesce(nullIf(p.city, ''), 'missing') = 'missing' RETURN p.name AS name, coalesce(nullIf(p.city, ''), 'missing') AS normalized_city",
      "expected": {
