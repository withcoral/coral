{
  "suite": "coral-graphql-read-baseline",
  "description": "Curated GraphQL read-only scenarios that Coral claims for virtual graph execution. These scenarios are synthetic and run end-to-end through GraphQL parsing, graph validation, shared graph IR lowering, SQL lowering, DataFusion execution, and result comparison.",
  "minimum_feature_counts": {
    "Aggregation": 6,
    "BooleanFilters": 6,
    "ErrorHandling": 6,
    "GeneratedClientShape": 5,
    "IdentityFields": 1,
    "NestedRelationships": 1,
    "RelationshipExistence": 1,
    "RootSelection": 2,
    "RowModifiers": 5,
    "ScalarFilters": 8
  },
  "scenarios": [
    {
      "id": "root-selection-filter-order-limit",
      "feature": "RootSelection",
      "query": "query { Person(where: { age: { gte: 30 }, active: { eq: true } }, orderBy: [{ field: name, direction: ASC }], limit: 2) { person: name city } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice", "city": "London" },
          { "person": "Carol", "city": "Paris" }
        ]
      }
    },
    {
      "id": "generated-root-alias-selection",
      "feature": "RootSelection",
      "query": "query { persons(where: { city: \"London\" }, orderBy: [{ field: name, direction: ASC }]) { person: name active } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "person": "Alice", "active": true },
          { "person": "Bob", "active": false }
        ]
      }
    },
    {
      "id": "scalar-string-filter-aliases",
      "feature": "ScalarFilters",
      "query": "query { Person(where: { or: [{ name: { startsWith: \"A\" } }, { name: { contains: \"ar\" } }] }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "scalar-list-filter",
      "feature": "ScalarFilters",
      "query": "query { Person(where: { city: { in: [\"London\", \"Paris\"] }, active: { isNotNull: true } }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Bob" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "scalar-numeric-range-gt-lt",
      "feature": "ScalarFilters",
      "query": "query { Person(where: { age: { gt: 29, lt: 41 } }) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "scalar-numeric-lte-boundary",
      "feature": "ScalarFilters",
      "query": "query { Person(where: { age: { lte: 34 } }, orderBy: [{ field: name, direction: ASC }]) { name age } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice", "age": 34 },
          { "name": "Bob", "age": 29 }
        ]
      }
    },
    {
      "id": "scalar-string-not-equal",
      "feature": "ScalarFilters",
      "query": "query { Person(where: { city: { ne: \"London\" } }) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "scalar-string-ends-with",
      "feature": "ScalarFilters",
      "query": "query { Person(where: { city: { endsWith: \"n\" } }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Bob" }
        ]
      }
    },
    {
      "id": "scalar-set-not-in",
      "feature": "ScalarFilters",
      "query": "query { Person(where: { name: { notIn: [\"Alice\", \"Bob\"] } }) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "scalar-null-check-is-null",
      "feature": "ScalarFilters",
      "query": "query { Person(where: { city: { isNull: true } }) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": []
      }
    },
    {
      "id": "boolean-filter-composition",
      "feature": "BooleanFilters",
      "query": "query { Person(where: { xor: [{ active: { eq: true } }, { city: { eq: \"Paris\" } }], not: { name: { eq: \"Bob\" } } }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "boolean-and-array",
      "feature": "BooleanFilters",
      "query": "query { Person(where: { and: [{ city: { eq: \"London\" } }, { active: { eq: true } }] }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "boolean-or-array",
      "feature": "BooleanFilters",
      "query": "query { Person(where: { or: [{ age: { gte: 41 } }, { active: { eq: false } }] }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Bob" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "boolean-nested-and-or",
      "feature": "BooleanFilters",
      "query": "query { Person(where: { and: [{ or: [{ name: { eq: \"Alice\" } }, { name: { eq: \"Bob\" } }] }, { city: { eq: \"London\" } }] }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Bob" }
        ]
      }
    },
    {
      "id": "boolean-not-nested-or",
      "feature": "BooleanFilters",
      "query": "query { Person(where: { not: { or: [{ city: { eq: \"Paris\" } }, { active: { eq: false } }] } }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "boolean-uppercase-or-alias",
      "feature": "BooleanFilters",
      "query": "query { Person(where: { OR: [{ name: { eq: \"Alice\" } }, { name: { eq: \"Carol\" } }] }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "row-modifiers-offset-limit",
      "feature": "RowModifiers",
      "query": "query { Person(orderBy: [{ field: age, direction: DESC }], offset: 1, limit: 1) { name age } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice", "age": 34 }
        ]
      }
    },
    {
      "id": "orderby-descending-alias",
      "feature": "RowModifiers",
      "query": "query { Person(orderBy: [{ field: age, direction: DESCENDING }]) { name age } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Carol", "age": 41 },
          { "name": "Alice", "age": 34 },
          { "name": "Bob", "age": 29 }
        ]
      }
    },
    {
      "id": "orderby-ascending-alias",
      "feature": "RowModifiers",
      "query": "query { Person(orderBy: [{ field: name, direction: ASCENDING }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Bob" },
          { "name": "Carol" }
        ]
      }
    },
    {
      "id": "orderby-shorthand-object",
      "feature": "RowModifiers",
      "query": "query { Person(orderBy: { age: DESC }) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Carol" },
          { "name": "Alice" },
          { "name": "Bob" }
        ]
      }
    },
    {
      "id": "root-distinct-projection",
      "feature": "RowModifiers",
      "query": "query { Person(distinct: true, orderBy: [{ field: city, direction: ASC }]) { city } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "city": "London" },
          { "city": "Paris" }
        ]
      }
    },
    {
      "id": "grouped-count-aggregate",
      "feature": "Aggregation",
      "query": "query { Person(orderBy: [{ field: city, direction: ASC }]) { city people: _count } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "city": "London", "people": 2 },
          { "city": "Paris", "people": 1 }
        ]
      }
    },
    {
      "id": "percentile-cont-aggregate",
      "feature": "Aggregation",
      "query": "query { Person { p75Age: _percentileCont(field: age, percentile: 0.75) } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "p75Age": 37.5 }
        ]
      }
    },
    {
      "id": "aggregate-sum-min-max",
      "feature": "Aggregation",
      "query": "query { Person { totalAge: _sum(field: age) youngest: _min(field: age) oldest: _max(field: age) } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "totalAge": 104, "youngest": 29, "oldest": 41 }
        ]
      }
    },
    {
      "id": "aggregate-avg-grouped-by-city",
      "feature": "Aggregation",
      "query": "query { Person(orderBy: [{ field: city, direction: ASC }]) { city avgAge: _avg(field: age) } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "city": "London", "avgAge": 31.5 },
          { "city": "Paris", "avgAge": 41.0 }
        ]
      }
    },
    {
      "id": "aggregate-count-distinct-city",
      "feature": "Aggregation",
      "query": "query { Person { distinctCities: _countDistinct(field: city) } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "distinctCities": 2 }
        ]
      }
    },
    {
      "id": "aggregate-min-max-grouped-by-city",
      "feature": "Aggregation",
      "query": "query { Person(orderBy: [{ field: city, direction: ASC }]) { city youngest: _min(field: age) oldest: _max(field: age) } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "city": "London", "youngest": 29, "oldest": 34 },
          { "city": "Paris", "youngest": 41, "oldest": 41 }
        ]
      }
    },
    {
      "id": "identity-fields",
      "feature": "IdentityFields",
      "query": "query { Person(where: { name: { eq: \"Alice\" } }) { id: _id element: _elementId name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "id": 1, "element": "1", "name": "Alice" }
        ]
      }
    },
    {
      "id": "nested-relationship-traversal",
      "feature": "NestedRelationships",
      "query": "query { Person(where: { name: { eq: \"Alice\" } }) { source: name out_KNOWS(to: Person, relationshipWhere: { since: { gte: 2021 } }, where: { active: { eq: true } }) { target: name _edge { since: since } } } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "source": "Alice", "target": "Carol", "since": 2022 }
        ]
      }
    },
    {
      "id": "relationship-existence-filter",
      "feature": "RelationshipExistence",
      "query": "query { Person(where: { out_KNOWS: { where: { city: { eq: \"Paris\" } }, relationshipWhere: { since: { gte: 2021 } } } }, orderBy: [{ field: name, direction: ASC }]) { name } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" },
          { "name": "Bob" }
        ]
      }
    },
    {
      "id": "fragment-typename-selection",
      "feature": "GeneratedClientShape",
      "query": "query { Person(orderBy: [{ field: name, direction: ASC }], limit: 1) { __typename ...PersonFields } } fragment PersonFields on Person { person: name }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "__typename": "Person", "person": "Alice" }
        ]
      }
    },
    {
      "id": "directive-skip-field-true",
      "feature": "GeneratedClientShape",
      "query": "query { Person(where: { name: { eq: \"Alice\" } }) { name age @skip(if: true) } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "directive-include-field-false",
      "feature": "GeneratedClientShape",
      "query": "query { Person(where: { name: { eq: \"Alice\" } }) { name city @include(if: false) } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "directive-skip-false-keeps-field",
      "feature": "GeneratedClientShape",
      "query": "query { Person(where: { name: { eq: \"Alice\" } }) { name age @skip(if: false) } }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice", "age": 34 }
        ]
      }
    },
    {
      "id": "directive-include-false-on-fragment-spread",
      "feature": "GeneratedClientShape",
      "query": "query { Person(where: { name: { eq: \"Alice\" } }) { name ...AgeFields @include(if: false) } } fragment AgeFields on Person { age }",
      "expected": {
        "kind": "rows",
        "ordered": true,
        "rows": [
          { "name": "Alice" }
        ]
      }
    },
    {
      "id": "unknown-property-rejection",
      "feature": "ErrorHandling",
      "query": "query { Person { missingProperty } }",
      "expected": {
        "kind": "error",
        "contains": "UNKNOWN_PROPERTY"
      }
    },
    {
      "id": "id-string-predicate-rejection",
      "feature": "ErrorHandling",
      "query": "query { Person(where: { _id: { startsWith: \"1\" } }) { name } }",
      "expected": {
        "kind": "error",
        "contains": "GraphQL _id filters do not support string predicates"
      }
    },
    {
      "id": "aggregate-sum-missing-field",
      "feature": "ErrorHandling",
      "query": "query { Person { _sum } }",
      "expected": {
        "kind": "error",
        "contains": "requires exactly one 'field' argument"
      }
    },
    {
      "id": "directive-unsupported-rejection",
      "feature": "ErrorHandling",
      "query": "query { Person { name @uppercase(foo: 1) } }",
      "expected": {
        "kind": "error",
        "contains": "unsupported GraphQL directive '@uppercase'"
      }
    },
    {
      "id": "orderby-invalid-direction-rejection",
      "feature": "ErrorHandling",
      "query": "query { Person(orderBy: [{ field: age, direction: SIDEWAYS }]) { name } }",
      "expected": {
        "kind": "error",
        "contains": "orderBy direction must be"
      }
    },
    {
      "id": "boolean-xor-arity-rejection",
      "feature": "ErrorHandling",
      "query": "query { Person(where: { xor: [{ active: { eq: true } }] }) { name } }",
      "expected": {
        "kind": "error",
        "contains": "requires exactly two objects"
      }
    }
  ]
}
