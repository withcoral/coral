{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["vendor/**"],
  "rules": {
    // The globals that the Rust host and these scripts share.
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__coralAnalyzeSavedFunctionCallPaths",
          "__coralAnalyzeSavedFunctionDependencies",
          "__coralAnalyzeSavedFunctionPaths",
          "__coralCompile",
          "__coralCompileLinkedProgram",
          "__coralConfigureCompiler",
          "__coralForbiddenAmbientGlobals",
          "__coralToolInvoke",
          "__coralPrepareSavedFunction",
          "__coralProgramEmit",
          "__coralProgramLog",
          "__coralTypeScriptVersion"
        ]
      }
    ]
  },
  "overrides": [
    {
      // compiler.rs joins these files into one function scope, so a file's
      // top-level declaration can be another file's dependency.
      // scripts/check-compiler-bridge.mjs lints the joined bridge instead.
      "files": ["src/js/compiler/**"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
