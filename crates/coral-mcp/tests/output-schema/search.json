{
  "anyOf": [
    {
      "$ref": "#/$defs/SearchResult"
    },
    {
      "$ref": "#/$defs/ToolFailure"
    }
  ],
  "description": "The MCP envelope's isError remains authoritative. Terminal Run failures\nare successful observations, not `ToolFailure` values.",
  "title": "ToolOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SearchResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchHit"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string",
          "description": "Present only while `has_more` is true."
        },
        "retriever_statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetrieverStatus"
          },
          "description": "The retrievers whose results may be missing; absent when none are."
        }
      },
      "required": [
        "hits",
        "has_more"
      ]
    },
    "SearchHit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_path": {
          "type": "string",
          "description": "`coral.providers.<namespace>.…` for a provider tool,\n`coral.functions.…` for a Saved Function."
        },
        "signature_line": {
          "type": "string",
          "description": "The callable's input members one level deep; a provider tool's result\ndata types by name, an unnamed object as `{…}`; a Saved Function's\nresult members one level deep. At most 512 UTF-8 bytes."
        }
      },
      "required": [
        "call_path",
        "signature_line"
      ],
      "description": "One Search Hit. Call a read from it when its signature line is complete:\nno cut marker (`…`) and no type named in its input that the line does not\nshow. Describe first otherwise, and before a write."
    },
    "RetrieverStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retriever": {
          "$ref": "#/$defs/Retriever"
        },
        "state": {
          "$ref": "#/$defs/RetrieverState"
        },
        "coverage": {
          "$ref": "#/$defs/RetrieverCoverage"
        }
      },
      "required": [
        "retriever",
        "state",
        "coverage"
      ]
    },
    "Retriever": {
      "type": "string",
      "enum": [
        "provider_tool",
        "saved_function"
      ]
    },
    "RetrieverState": {
      "type": "string",
      "enum": [
        "partial",
        "error"
      ],
      "description": "- `partial`: some Providers or Saved Functions are not indexed yet, or\n  failed; results may be missing.\n- `error`: the retriever could not rank; its results are missing.\n\nRetry shortly or list without a query."
    },
    "RetrieverCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eligible_units": {
          "type": "integer",
          "minimum": 0
        },
        "searched_units": {
          "type": "integer",
          "minimum": 0
        },
        "failed_units": {
          "type": "integer",
          "minimum": 0
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "eligible_units",
        "searched_units",
        "failed_units",
        "returned_count",
        "has_more"
      ]
    },
    "ToolFailure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "trace_id": {
          "type": "string",
          "description": "The W3C trace identifier of this tool call. Give it to the operator\nto find the call in Coral's telemetry. It grants no authority."
        }
      },
      "required": [
        "code",
        "message",
        "trace_id"
      ]
    }
  },
  "type": "object"
}
