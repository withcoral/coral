          "type": "string"
        }
      },
      "required": [
        "authenticator"
      ],
      "additionalProperties": true
    },
    "RateLimitSpec": {
      "description": "Provider-specific response hints for classifying and delaying rate-limit retries.",
      "type": "object",
      "properties": {
        "extra_statuses": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint16",
            "minimum": 0,
            "maximum": 65535
          },
          "default": []
        },
        "retry_after_header": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "remaining_header": {
