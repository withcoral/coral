{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coral DSL v4 Source Manifest",
  "type": "object",
  "properties": {
    "dsl_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "const": 4
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "test_queries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/V4SurfaceSchema"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "dsl_version",
    "name",
    "surfaces"
  ],
  "$defs": {
    "V4SurfaceSchema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "namespace_suffix": {
              "type": "string",
              "description": "Source-relative relation namespace suffix. When present, Coral exposes the surface as <source_name>_<namespace_suffix>; when omitted, the surface uses <source_name>.",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/V4InputSpecSchema"
              },
              "propertyNames": {
                "minLength": 1
              }
            },
            "base_url": {
              "type": "string",
              "minLength": 1
            },
            "auth": {
              "$ref": "#/$defs/AuthSpec",
              "default": {
                "type": "HeaderAuth",
                "headers": []
              }
            },
            "request_headers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HeaderSpec"
              }
            },
            "rate_limit": {
              "$ref": "#/$defs/RateLimitSpec",
              "default": {
                "extra_statuses": [],
                "retry_after_header": null,
                "remaining_header": null,
                "reset_header": null
              }
            },
            "pagination": {
              "anyOf": [
                {
                  "$ref": "#/$defs/V4OpenApiSurfacePaginationSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "openapi"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "oneOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "file"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "namespace_suffix": {
              "type": "string",
              "description": "Source-relative relation namespace suffix. When present, Coral exposes the surface as <source_name>_<namespace_suffix>; when omitted, the surface uses <source_name>.",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/V4InputSpecSchema"
              },
              "propertyNames": {
                "minLength": 1
              }
            },
            "server": {
              "$ref": "#/$defs/McpServerSpec"
            },
            "pagination": {
              "anyOf": [
                {
                  "$ref": "#/$defs/V4McpSurfacePaginationSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "mcp"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "server"
          ]
        }
      ]
    },
    "V4InputSpecSchema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "default": {
              "type": [
                "string",
                "null"
              ]
            },
            "required": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "variable"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "required": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "credential": true,
            "kind": {
              "type": "string",
              "const": "secret"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "AuthSpec": {
      "description": "Source-level authentication requirements for HTTP-backed source specs.",
      "oneOf": [
        {
          "description": "HTTP Basic authentication; runtime base64-encodes `username:password`.",
          "type": "object",
          "properties": {
            "username": {
              "$ref": "#/$defs/ParsedTemplate"
            },
            "password": {
              "$ref": "#/$defs/ParsedTemplate"
            },
            "type": {
              "type": "string",
              "const": "BasicAuth"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "username",
            "password"
          ]
        },
        {
          "description": "Declarative list of auth headers to attach to the request.",
          "type": "object",
          "properties": {
            "headers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HeaderSpec"
              },
              "default": []
            },
            "type": {
              "type": "string",
              "const": "HeaderAuth"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Dispatches auth header resolution to a runtime-registered authenticator.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "CustomAuth"
            }
          },
          "$ref": "#/$defs/CustomAuthSpec",
          "required": [
            "type"
          ]
        }
      ]
    },
    "ParsedTemplate": {
      "type": "string"
    },
    "HeaderSpec": {
      "description": "One request or auth header declared in the source spec.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "template": {
              "$ref": "#/$defs/ParsedTemplate"
            },
            "from": {
              "type": "string",
              "const": "template"
            }
          },
          "required": [
            "from",
            "template"
          ]
        },
        {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ValueSourceSpec"
              }
            },
            "from": {
              "type": "string",
              "const": "one_of"
            }
          },
          "required": [
            "from",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": true,
            "from": {
              "type": "string",
              "const": "literal"
            }
          },
          "required": [
            "from",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "default": {
              "default": null
            },
            "from": {
              "type": "string",
              "const": "filter"
            }
          },
          "required": [
            "from",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "default": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "default": null
            },
            "from": {
              "type": "string",
              "const": "filter_int"
            }
          },
          "required": [
            "from",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "default": {
              "type": [
                "boolean",
                "null"
              ],
              "default": null
            },
            "from": {
              "type": "string",
              "const": "filter_bool"
            }
          },
          "required": [
            "from",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "separator": {
              "type": "string"
            },
            "part": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "from": {
              "type": "string",
              "const": "filter_split"
            }
          },
          "required": [
            "from",
            "key",
            "separator",
            "part"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "separator": {
              "type": "string"
            },
            "part": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "from": {
              "type": "string",
              "const": "filter_split_int"
            }
          },
          "required": [
            "from",
            "key",
            "separator",
            "part"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "default": {
              "default": null
            },
            "from": {
              "type": "string",
              "const": "arg"
            }
          },
          "required": [
            "from",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "default": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "default": null
            },
            "from": {
              "type": "string",
              "const": "arg_int"
            }
          },
          "required": [
            "from",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "default": {
              "type": [
                "boolean",
                "null"
              ],
              "default": null
            },
            "from": {
              "type": "string",
              "const": "arg_bool"
            }
          },
          "required": [
            "from",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "separator": {
              "type": "string"
            },
            "part": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "from": {
              "type": "string",
              "const": "arg_split"
            }
          },
          "required": [
            "from",
            "key",
            "separator",
            "part"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "separator": {
              "type": "string"
            },
            "part": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "from": {
              "type": "string",
              "const": "arg_split_int"
            }
          },
          "required": [
            "from",
            "key",
            "separator",
            "part"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "from": {
              "type": "string",
              "const": "input"
            }
          },
          "required": [
            "from",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "from": {
              "type": "string",
              "const": "bearer"
            }
          },
          "required": [
            "from",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "from": {
              "type": "string",
              "const": "state"
            }
          },
          "required": [
            "from",
            "key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "integer",
              "format": "int64"
            },
            "from": {
              "type": "string",
              "const": "now_epoch_minus_seconds"
            }
          },
          "required": [
            "from",
            "seconds"
          ]
        }
      ]
    },
